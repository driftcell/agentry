{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn",
    "eqeqeq": "error",
    "react/jsx-key": "error",
    "react/no-danger": "error"
  },
  "ignorePatterns": ["dist", "../crates/server/static", "node_modules"]
}
