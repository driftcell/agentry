# Agentry runtime configuration
APP_ENV=production
DATABASE_URL=postgres://agentry:agentry@postgres:5432/agentry
SERVER_ADDR=0.0.0.0:8080
SERVER_PUBLIC_URL=http://localhost:8080

# External S3-compatible object storage (required in production)
STORAGE_BACKEND=s3
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=replace-me
OSS_SECRET_ACCESS_KEY=replace-me
OSS_VIRTUAL_HOST_STYLE=true
OSS_PRESIGN_TTL_SECONDS=600
BUNDLE_TTL_SECONDS=900

# Change immediately after the first boot
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-on-first-deploy
